# Example environment configuration for Life as a Garden API
# Copy this file to .env and update with your actual values

# OpenAI API Key for image analysis
OPENAI_API_KEY=your_openai_api_key_here

# Service URLs (adjust if needed)
FRONTEND_URL=http://frontend:80/
RMAPI_SERVICE_URL=http://rmapi-wrapper:8001

# Email notification settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
NOTIFICATION_EMAIL=lebensgarten@timosur.com
EMAIL_NOTIFICATIONS_ENABLED=true

# Email setup instructions:
# 1. For Gmail: Enable 2-factor authentication and create an App Password
# 2. For other providers: Use your regular SMTP credentials
# 3. Set EMAIL_NOTIFICATIONS_ENABLED=false to disable notifications
